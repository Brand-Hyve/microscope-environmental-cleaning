---
// Static contact panel. Online assessment submission is intentionally
// unavailable: this component renders no form, no inputs, and no data endpoint.
// The component name and `compact` prop are kept so existing call sites work.
import { site } from "../data/site";
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
---
<div class="grid gap-4" role="group" aria-label="Contact options">
  <p class:list={["text-ink-800 leading-relaxed", compact ? "text-sm" : "text-base"]}>
    Online assessment requests are not available on this website. To request an assessment,
    please call or email us directly.
  </p>

  <div class:list={["flex gap-3", compact ? "flex-col" : "flex-col sm:flex-row sm:flex-wrap"]}>
    <a href={site.phoneHref} class="btn btn-primary">Call {site.phone}</a>
    <a href={`mailto:${site.email}`} class="btn btn-secondary break-all">Email {site.email}</a>
  </div>

  <p class="text-xs text-ink-600 leading-relaxed">
    Please do not send medical records, lab reports, or other sensitive health details by
    ordinary email. Call us instead to talk through your situation.
  </p>
</div>
