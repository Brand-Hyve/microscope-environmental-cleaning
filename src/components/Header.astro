---
import { nav, site } from "../data/site";
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur border-b border-ink-100">
  <div class="container-x flex items-center justify-between gap-4 py-3">
    <a href="/" class="flex items-center gap-2.5 shrink-0" aria-label={`${site.name} home`}>
      <img src="/logo.svg" alt="" width="44" height="44" class="h-11 w-11 object-contain" />
      <span class="leading-tight">
        <span class="block font-serif text-[1.05rem] font-semibold text-ink-900">Microscope</span>
        <span class="block text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-spa-700">Environmental Cleaning</span>
      </span>
    </a>

    <nav class="hidden lg:flex items-center gap-1" aria-label="Primary">
      {nav.filter((n) => n.label !== "Contact").map((item) => (
        <div class="relative group">
          <a
            href={item.href}
            class:list={[
              "px-3 py-2 rounded-lg text-sm font-medium transition-colors",
              isActive(item.href) ? "text-brand-700" : "text-ink-700 hover:text-brand-700",
            ]}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
          {item.children && (
            <div class="absolute left-0 top-full pt-2 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-150">
              <div class="w-64 card p-2">
                {item.children.map((c) => (
                  <a href={c.href} class="block px-3 py-2 rounded-lg text-sm text-ink-700 hover:bg-spa-50 hover:text-brand-700">
                    {c.label}
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      ))}
    </nav>

    <div class="hidden lg:flex items-center gap-3 shrink-0">
      <a href={site.phoneHref} class="text-sm font-semibold text-ink-800 hover:text-brand-700">{site.phone}</a>
      <a href="/contact/" class="btn btn-primary text-sm py-2.5 px-4">Request an Assessment</a>
    </div>

    <!-- Mobile toggle -->
    <button
      id="menu-toggle"
      class="lg:hidden inline-flex items-center justify-center h-11 w-11 rounded-lg border border-ink-200 text-ink-800"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
      <svg id="icon-close" class="hidden" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="lg:hidden hidden border-t border-ink-100 bg-white">
    <nav class="container-x py-4 flex flex-col gap-1" aria-label="Mobile">
      {nav.map((item) => (
        <div>
          <a href={item.href} class="block px-2 py-3 rounded-lg font-medium text-ink-800 hover:bg-spa-50">{item.label}</a>
          {item.children && (
            <div class="ml-3 border-l border-ink-100 pl-3 mb-1">
              {item.children.map((c) => (
                <a href={c.href} class="block px-2 py-2 text-sm text-ink-600 hover:text-brand-700">{c.label}</a>
              ))}
            </div>
          )}
        </div>
      ))}
      <div class="mt-3 flex flex-col gap-2">
        <a href={site.phoneHref} class="btn btn-secondary">Call {site.phone}</a>
        <a href="/contact/" class="btn btn-primary">Request an Assessment</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    iconOpen?.classList.toggle("hidden", open);
    iconClose?.classList.toggle("hidden", !open);
  });
</script>
