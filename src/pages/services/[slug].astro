---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Placeholder from "../../components/Placeholder.astro";
import CtaBand from "../../components/CtaBand.astro";
import Check from "../../components/Check.astro";
import Arrow from "../../components/Arrow.astro";
import AssessmentForm from "../../components/AssessmentForm.astro";
import { services, site } from "../../data/site";

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}

const { service } = Astro.props;
const related = services
  .filter((s) => s.category === service.category && s.slug !== service.slug)
  .slice(0, 3);
const catLabel = service.category === "premium" ? "Environmental Cleaning" : "Restoration & Remediation";
---

<BaseLayout title={service.title} description={service.summary}>
  <section class="bg-gradient-to-b from-spa-50 to-white">
    <div class="container-x pt-10 pb-12 md:pt-14 md:pb-16">
      <nav class="text-sm text-ink-500 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-brand-700">Home</a>
        <span class="mx-2">/</span>
        <a href="/services/" class="hover:text-brand-700">Services</a>
        <span class="mx-2">/</span>
        <span class="text-ink-700">{service.title}</span>
      </nav>
      <div class="grid lg:grid-cols-2 gap-10 items-center">
        <div>
          <span class="eyebrow"><span class="h-1.5 w-1.5 rounded-full bg-brand-500"></span> {catLabel}</span>
          <h1 class="mt-4 text-4xl md:text-5xl">{service.title}</h1>
          <p class="mt-5 text-lg text-ink-700 leading-relaxed">{service.summary}</p>
          <div class="mt-8 flex flex-col sm:flex-row gap-3">
            <a href="/contact/" class="btn btn-primary">Request an Assessment</a>
            <a href={site.phoneHref} class="btn btn-secondary">Call {site.phone}</a>
          </div>
        </div>
        <div>
          <Placeholder shot={`${service.title} — representative field photo`} ratio="4/3" />
        </div>
      </div>
    </div>
  </section>

  <section class="container-x py-14 md:py-20 grid lg:grid-cols-[1.4fr_1fr] gap-12">
    <div>
      {service.forWhom && (
        <div class="rounded-2xl border border-spa-200 bg-spa-50 p-6 mb-8">
          <p class="text-sm font-semibold uppercase tracking-wider text-spa-700">Who it's for</p>
          <p class="mt-2 text-ink-800 leading-relaxed">{service.forWhom}</p>
        </div>
      )}
      <h2 class="text-2xl md:text-3xl">What's included</h2>
      <ul class="mt-6 space-y-3">
        {service.includes.map((item) => (
          <li class="flex items-start gap-3 text-ink-800"><span class="mt-1"><Check /></span> <span class="leading-relaxed">{item}</span></li>
        ))}
      </ul>

      <div class="mt-10 rounded-2xl bg-ink-900 text-white p-7">
        <h3 class="text-white text-xl">Every job is verified.</h3>
        <p class="mt-2 text-spa-100 leading-relaxed">
          We confirm our work with 0.3-micron particle counting — and can add ERMI or EMMA dust
          sampling on request — so you have documented proof, not just our word.
        </p>
      </div>

      {related.length > 0 && (
        <div class="mt-12">
          <h2 class="text-2xl">Related services</h2>
          <div class="mt-5 grid sm:grid-cols-3 gap-4">
            {related.map((r) => (
              <a href={`/services/${r.slug}/`} class="card card-hover p-5">
                <h3 class="text-base">{r.title}</h3>
                <span class="mt-3 text-sm font-semibold text-brand-700 inline-flex items-center gap-1">View <Arrow /></span>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>

    <aside class="lg:sticky lg:top-24 h-fit">
      <div class="card p-6">
        <h3 class="text-xl">Contact us directly</h3>
        <p class="mt-1 text-sm text-ink-600">Call or email us to request an assessment. We respond personally.</p>
        <div class="mt-5">
          <AssessmentForm compact={true} />
        </div>
      </div>
    </aside>
  </section>

  <CtaBand />
</BaseLayout>
