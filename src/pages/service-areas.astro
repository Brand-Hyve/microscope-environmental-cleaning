---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "../components/CtaBand.astro";
import { serviceAreas, site } from "../data/site";
---

<BaseLayout title="Service Areas" description="Microscope Environmental Cleaning serves Southwest Florida — Lee, Collier, Charlotte, and Sarasota counties, including Naples, Fort Myers, Sarasota, Bonita Springs, and Marco Island.">
  <section class="bg-gradient-to-b from-spa-50 to-white">
    <div class="container-x pt-14 pb-12 md:pt-20 md:pb-16 max-w-3xl">
      <span class="eyebrow"><span class="h-1.5 w-1.5 rounded-full bg-brand-500"></span> Service Areas</span>
      <h1 class="mt-4 text-4xl md:text-5xl">Serving Southwest Florida.</h1>
      <p class="mt-5 text-lg text-ink-700 leading-relaxed">
        We provide environmental cleaning and restoration across four counties — from the beaches of
        Sarasota to the estates of Naples. Don't see your community listed? Call us at
        <a href={site.phoneHref} class="font-semibold text-brand-700"> {site.phone}</a> — if you're in
        the region, we can likely help.
      </p>
    </div>
  </section>

  <section class="container-x py-14 md:py-20">
    <div class="grid sm:grid-cols-2 gap-6">
      {serviceAreas.map((area) => (
        <div class="card p-7">
          <h2 class="text-2xl">{area.county}</h2>
          <ul class="mt-4 flex flex-wrap gap-2">
            {area.places.map((place) => (
              <li class="rounded-full bg-spa-50 border border-spa-100 px-3.5 py-1.5 text-sm text-ink-700">{place}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="mt-8 text-ink-600">
      Proudly serving {site.serviceRegion}, including its most discerning communities — Old Naples,
      Port Royal, Pelican Bay, Park Shore, The Moorings, Siesta Key, Longboat Key, and Lakewood Ranch.
    </p>
  </section>

  <CtaBand heading="In our service area?" sub="Request an assessment and we'll schedule a visit to understand your home and your needs." />
</BaseLayout>
